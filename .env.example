# ──────────────────────────────────────────────────────────────────────────────
# Digital Human — Centro Medico San Marco
# Variabili d'ambiente OPZIONALI (solo per comodità in sviluppo locale).
#
# ⚠️  ATTENZIONE: le variabili con prefisso VITE_ sono incorporate nel bundle
#     client-side e quindi VISIBILI nel browser. Non usarle per segreti di
#     produzione. In produzione inserisci le chiavi dall'interfaccia (runtime).
#
# Copia questo file in `.env` e compila i valori desiderati:
#     cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# Google Gemini API Key — https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Simli API Key — https://app.simli.com
# Se assente o vuota, l'app funziona in modalità solo-audio (avatar circolare).
VITE_SIMLI_API_KEY=

# Face ID Simli opzionale. Se vuoto viene usato il volto predefinito.
VITE_SIMLI_FACE_ID=
